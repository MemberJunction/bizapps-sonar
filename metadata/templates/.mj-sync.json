  "pull": {
    "createNewFileIfNotFound": true,
    "newFileName": ".sonar-templates.json",
    "appendRecordsToExistingFile": true,
    "updateExistingRecords": true,
    "mergeStrategy": "merge",
    "ignoreNullFields": true,
    "ignoreVirtualFields": true,
    "filter": "ID IN ('40F49DD4-0712-4263-8785-5346F023FFA1', '5044A100-0022-4000-8000-000000000022')",
    "relatedEntities": {
      "MJ: Template Contents": {
        "entity": "MJ: Template Contents",
        "foreignKey": "TemplateID"
      }
    }
  }
}