# npm-only keys (legacy-peer-deps, package-lock) removed in the pnpm migration;
# their pnpm equivalents live in pnpm-workspace.yaml. Everything below is read
# by both npm and pnpm, so the `npm view` calls in .github/scripts stay quiet.
# NPM Configuration for bizapps-sonar

# Save exact versions (matching MJ pattern)
save-exact=true

# Use lockfile

# Allow flexible peer dependency resolution (required for Angular + PrimeNG workspace)

# Strict SSL
strict-ssl=true
