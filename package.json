{
  "name": "bizapps-sonar",
  "version": "1.0.0",
  "license": "BUSL-1.1",
  "description": "Sonar - Configurable engagement scoring engine built as a MemberJunction Open App",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build --filter=\"@mj-biz-apps/*\"",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/sonar-entities\" --filter=\"@mj-biz-apps/sonar-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/sonar-*\"",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsSonar --dir ./migrations",
    "mj:migrate:pg": "mj migrate --schema __mj_BizAppsSonar --dir ./migrations-pg",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema __mj_BizAppsSonar",
    "mj:codegen": "mj codegen",
    "install:deps": "pnpm install",
    "setup": "echo 'Please run: pnpm run mj:migrate && pnpm run mj:codegen && pnpm run build'",
    "change": "changeset",
    "version": "changeset version && node scripts/sync-app-version.mjs",
    "test": "pnpm -r --if-present test",
    "lint:distribution": "node scripts/check-distribution-seed.mjs",
    "lint:distribution:test": "node scripts/check-distribution-seed.spec.mjs",
    "lint:sync-app-version:test": "node --test scripts/sync-app-version.spec.mjs",
    "lint:release-pushes": "node scripts/check-release-pushes.mjs",
    "lint:release-pushes:test": "node --test scripts/check-release-pushes.spec.mjs",
    "lint:release-plan:test": "node --test scripts/release-plan.spec.mjs",
    "lint:paths-touched:test": "node --test scripts/check-paths-touched.spec.mjs",
    "lint:release-prep:test": "node --test scripts/release-prep.spec.mjs",
    "release:plan": "node scripts/release-prep.mjs --plan",
    "check:release-seed": "node scripts/check-release-seed-coverage.mjs",
    "check:release-seed:test": "node scripts/check-release-seed-coverage.spec.mjs",
    "check:seed-cadence": "node scripts/check-release-seed-cadence.mjs",
    "check:seed-cadence:test": "node scripts/check-release-seed-cadence.spec.mjs",
    "check:pg-parity": "node scripts/check-pg-parity.mjs",
    "check:teardown-tolerance": "node scripts/check-teardown-version-tolerance.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-sonar"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^6.1.5",
    "@types/node": "^25.7.0",
    "beasties": "0.3.5",
    "mrmime": "2.0.1",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@angular-devkit/build-angular": "21.2.23",
      "@angular/animations": "21.2.22",
      "@angular/build": "21.2.23",
      "@angular/cdk": "21.2.14",
      "@angular/cli": "21.2.23",
      "@angular/common": "21.2.22",
      "@angular/compiler": "21.2.22",
      "@angular/compiler-cli": "21.2.22",
      "@angular/core": "21.2.22",
      "@angular/forms": "21.2.22",
      "@angular/localize": "21.2.22",
      "@angular/platform-browser": "21.2.22",
      "@angular/platform-browser-dynamic": "21.2.22",
      "@angular/router": "21.2.22",
      "@angular/service-worker": "21.2.22",
      "@memberjunction/core": "^6.1.5",
      "@memberjunction/global": "^6.1.5"
    }
  }
}
