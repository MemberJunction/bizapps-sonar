{
  "extends": "../../tsconfig.angular.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "enableResourceInlining": true,
    "strictTemplates": true
  },
  "include": ["src/**/*"],
  "// exclude note": "Tests are vitest-only — keep them out of the ngc build so the published dist doesn't ship test code importing vitest, which isn't a runtime dependency.",
  "exclude": ["node_modules", "src/**/__tests__/**", "src/**/*.test.ts"]
}
